# Copy to config.local.sh (untracked) and edit. lib.sh sources it before applying its own
# defaults; `: "${VAR:=...}"` keeps an exported environment variable winning over this file.
: "${FOLDDISCO_REPO:=$HOME/folddisco}"                  # folddisco checkout to build
: "${FOLDDISCO_BENCH_DATA:=$HOME/folddisco-bench-data}" # root of the inputs below

